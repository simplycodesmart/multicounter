<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="#171717">

    <!-- Counter title -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="MultiCounter"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="10dp" />

    <!-- Countdown / Count-up values -->
    <LinearLayout
        android:id="@+id/widget_time_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="4">

        <!-- Days -->
        <LinearLayout
            android:id="@+id/days_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/widget_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textColor="#FFFFD400"
                android:textSize="25sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="48sp" />

            <TextView
                android:id="@+id/widget_days_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAYS"
                android:textColor="#BFFFFFFF"
                android:textSize="9sp"
                android:gravity="center"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Hours -->
        <LinearLayout
            android:id="@+id/hours_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/widget_hours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="00"
                android:textColor="#FFFFD400"
                android:textSize="25sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="48sp" />

            <TextView
                android:id="@+id/widget_hours_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HRS"
                android:textColor="#BFFFFFFF"
                android:textSize="9sp"
                android:gravity="center"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Minutes -->
        <LinearLayout
            android:id="@+id/minutes_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/widget_minutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="00"
                android:textColor="#FFFFD400"
                android:textSize="25sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="48sp" />

            <TextView
                android:id="@+id/widget_minutes_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MINS"
                android:textColor="#BFFFFFFF"
                android:textSize="9sp"
                android:gravity="center"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Seconds -->
        <LinearLayout
            android:id="@+id/seconds_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/widget_seconds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="00"
                android:textColor="#FFFFD400"
                android:textSize="25sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="48sp" />

            <TextView
                android:id="@+id/widget_seconds_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECS"
                android:textColor="#BFFFFFFF"
                android:textSize="9sp"
                android:gravity="center"
                android:includeFontPadding="false" />
        </LinearLayout>

    </LinearLayout>

    <!-- Tally counter -->
    <TextView
        android:id="@+id/widget_tally"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0"
        android:textColor="#FFFFD400"
        android:textSize="32sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:visibility="gone" />

</LinearLayout>
